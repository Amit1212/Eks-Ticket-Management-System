@model TicketFrontend.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Ticket Dashboard</h1>
            <p class="text-muted mb-0">
                Monitor and manage support tickets
            </p>
        </div>

        <a href="#" class="btn btn-primary">
            + Create Ticket
        </a>
    </div>

    <!-- Summary Cards -->

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted">
                        Total Tickets
                    </div>

                    <h2 class="fw-bold">
                        @Model.TotalTickets
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted">
                        Open
                    </div>

                    <h2 class="fw-bold">
                        @Model.OpenTickets
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted">
                        In Progress
                    </div>

                    <h2 class="fw-bold">
                        @Model.InProgressTickets
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted">
                        Closed
                    </div>

                    <h2 class="fw-bold">
                        @Model.ClosedTickets
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- Tickets -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                Recent Tickets
            </h5>
        </div>

        <div class="card-body p-0">

            @if (!Model.Tickets.Any())
            {
                <div class="p-4 text-center text-muted">
                    No tickets found.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>Ticket</th>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Assigned To</th>
                                <th>Created</th>
                            </tr>

                        </thead>

                        <tbody>

                        @foreach (var ticket in Model.Tickets)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @ticket.TicketNumber
                                    </strong>
                                </td>

                                <td>
                                    @ticket.Title
                                </td>

                                <td>
                                    @ticket.Category
                                </td>

                                <td>
                                    @ticket.Priority
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @ticket.Status
                                    </span>
                                </td>

                                <td>
                                    @(ticket.AssignedTo ?? "Unassigned")
                                </td>

                                <td>
                                    @(ticket.CreatedDate.ToLocalTime().ToString("dd-MMM-yyyy HH:mm"))
                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>
